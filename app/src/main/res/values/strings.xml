    <string name="settings_privacy_policy_body">All BMI calculations, measurements, saved history records, and app preferences (theme and default units) are stored locally on your device and are not uploaded to our servers.\n\nAdvertising: This app displays ads provided by Start.io. When an internet connection is available, Start.io may collect device and advertising identifiers or usage diagnostics in accordance with Start.io\'s privacy policy to deliver and measure ads. You can clear all locally saved BMI history at any time from the History screen or reset your device advertising ID in Android system settings.</string>
    <string name="settings_about_app_body">BMI Calculator helps you compute your Body Mass Index using Metric (cm, kg) or Imperial (ft/in, lb) measurements, view healthy weight ranges for your height, and keep a local history of saved calculations.\n\nVersion: %1$s\nStorage: On-device local database</string>
    <string name="settings_terms_conditions_body">BMI Calculator is provided for general informational and educational purposes only.\n\nBody Mass Index is a screening tool and does not constitute medical advice, diagnosis, or treatment. Standard adult BMI categories apply to adults aged 20 and above and may not accurately reflect body composition for athletes, older adults, pregnant individuals, or children and teenagers.\n\nAlways consult a qualified healthcare professional before making health, diet, or exercise decisions.</string>
    <string name="settings_section_app">Application</string>
    <string name="settings_version_label">App Version</string>

    <!-- BMI Calculation Methodology Container -->
    <string name="about_methodology_section">BMI Calculation Methodology</string>
    <string name="methodology_overview">Body Mass Index (BMI) is a screening measure calculated offline on your device using your height and weight.</string>
    <string name="about_metric_formula_label">Metric Formula</string>
    <string name="about_metric_formula">BMI = Weight (kg) ÷ Height (m)²</string>
    <string name="methodology_metric_note">Height in centimeters is converted to meters (cm ÷ 100) before squaring.</string>
    <string name="about_imperial_formula_label">Imperial Formula</string>
    <string name="about_imperial_formula">BMI = (Weight (lb) × 703) ÷ Height (in)²</string>
    <string name="methodology_imperial_note">Total height in inches is calculated as (feet × 12) + inches.</string>
    <string name="about_categories_label">Adult Categories (20+ years)</string>
    <string name="about_cat_underweight_range">Below 18.5</string>
    <string name="about_cat_normal_range">18.5 – 24.9</string>
    <string name="about_cat_overweight_range">25.0 – 29.9</string>
    <string name="about_cat_obese_range">30.0 or above</string>
    <string name="methodology_healthy_weight_label">Healthy Weight Reference</string>
    <string name="methodology_healthy_weight_note">The healthy weight range for your height is derived by solving the BMI formula for values between 18.5 and 24.9.</string>
    <string name="methodology_disclaimer_title">Disclaimer &amp; Limitations</string>
    <string name="methodology_disclaimer_body">Standard adult BMI categories apply to adults aged 20 and above. BMI is a general screening indicator and does not directly measure body fat percentage, muscle mass, fat distribution, or bone density. Athletes and muscular individuals, older adults, pregnant or nursing individuals, and children or teenagers (who require age- and sex-specific BMI-for-age percentiles) require different clinical interpretation. This application is for informational purposes only and is not a substitute for professional medical advice, diagnosis, or treatment.</string>
